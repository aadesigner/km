# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Local:   postgres://user:pass@localhost:5432/kmcheck
# Railway: copied from the Railway Postgres plugin dashboard
DATABASE_URL=postgres://user:pass@localhost:5432/kmcheck

# Secret used to sign JWT session tokens — any long random string
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-generate-a-long-random-string

# Email address that gets admin access on first login
ADMIN_EMAIL=you@example.com

# ── API server ─────────────────────────────────────────────────────────────────

# Port the API server listens on (default: 8080)
PORT=8080

# Node environment — set to "production" in prod
NODE_ENV=production

# Allowed CORS origins for the API (comma-separated full origins, e.g. https://kmcheck.com)
# Not needed when frontend and API share the same origin (nginx proxy, Railway, etc.)
# In development, LAN/Tailscale origins (100.x, 192.168.x, 10.x) are auto-allowed.
# Set CORS_ALLOW_LAN=false to disable that behavior.
CORS_ORIGIN=http://localhost:5173

# Shared secret between the web app and API server. When set, the API rejects direct
# third-party calls (curl, Postman, other sites) unless they send this header or come
# from an allowed browser origin. Use the SAME value for VITE_CLIENT_GUARD_TOKEN.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CLIENT_GUARD_TOKEN=

# Enforce client guard in development (optional — production enforces automatically when token is set)
# CLIENT_GUARD_ENFORCE=true

# Rate limit for untrusted direct API access only (web app traffic is skipped)
# PUBLIC_RATE_LIMIT_MAX=40
# PUBLIC_RATE_LIMIT_WINDOW_MS=900000

# ── Optional / convenience ────────────────────────────────────────────────────

# Seed the Carstat VIN data provider on first start (can also be set via admin panel)
CARSTAT_API_KEY=

# PayPal credentials — can be set here as a bootstrap or via the admin panel
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Fallback site URL used in password-reset emails if not set via admin panel
SITE_URL=https://kmcheck.com

# ── Railway / production (see docs/RAILWAY-DEPLOY.md) ─────────────────────────
# NODE_ENV=production
# CLIENT_GUARD_TOKEN=          # required in production — generate random string
# VITE_CLIENT_GUARD_TOKEN=     # MUST match CLIENT_GUARD_TOKEN (set at build time on Railway)
# CORS_ORIGIN=https://kmcheck.com,https://www.kmcheck.com
# DATABASE_URL is set by Railway Postgres plugin (add ?sslmode=require for external access)

# Pino log level: trace | debug | info | warn | error (default: info)
LOG_LEVEL=info

# Max PostgreSQL pool connections (default: 20)

# Geo language redirect — force country on localhost (optional; dev also auto-detects egress IP)
# GEO_DEV_DEFAULT_COUNTRY=AL
PG_POOL_MAX=20

# Set to "true" to allow SMTP connections without TLS certificate verification
# (only for trusted internal SMTP servers — never use in production)
SMTP_INSECURE=false

# ── Frontend dev server (local development only) ──────────────────────────────

# Port for the Vite dev server (default: 5173)
# PORT=5173

# Port of the API server that the Vite dev proxy should forward /api calls to
# API_PORT=8080

# Must match CLIENT_GUARD_TOKEN on the API server (embedded in the frontend build)
# VITE_CLIENT_GUARD_TOKEN=
